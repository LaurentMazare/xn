#version 450
#include "dtype.glsl"
// dst = src * scale + add   (elementwise)
layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) buffer S { SCALAR src[]; };
layout(std430, set = 0, binding = 1) buffer D { SCALAR dst[]; };

layout(push_constant) uniform PC {
    uint n;
    float scale;
    float add;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    dst[i] = STORE(LOAD(src[i]) * pc.scale + pc.add);
}
