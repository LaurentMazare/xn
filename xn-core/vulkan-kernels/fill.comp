#version 450
#include "dtype.glsl"
// Fill a buffer with a constant. Runs on the GPU so `zeros`/`full` stay inside
// the recorded batch instead of forcing a host round trip.
layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) buffer D { SCALAR dst[]; };

layout(push_constant) uniform PC {
    uint n;
    float v;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    dst[i] = STORE(pc.v);
}
