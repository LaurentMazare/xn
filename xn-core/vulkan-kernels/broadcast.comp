#version 450
#include "dtype.glsl"
// General strided broadcast binary op. `info` packs, per dimension:
//   [dims (num_dims), lhs_strides (num_dims), rhs_strides (num_dims)]
// A broadcast dimension has stride 0. Destination is contiguous row-major.
layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) buffer L { SCALAR lhs[]; };
layout(std430, set = 0, binding = 1) buffer R { SCALAR rhs[]; };
layout(std430, set = 0, binding = 2) buffer D { SCALAR dst[]; };
layout(std430, set = 0, binding = 3) readonly buffer I { uint info[]; };

layout(push_constant) uniform PC {
    uint numel;
    uint num_dims;
    uint op;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.numel) return;
    uint nd = pc.num_dims;
    uint li = 0u;
    uint ri = 0u;
    uint rem = idx;
    for (uint d = 0u; d < nd; d++) {
        uint di = nd - 1u - d;
        uint dimv = info[di];
        uint coord = rem % dimv;
        rem /= dimv;
        li += coord * info[nd + di];
        ri += coord * info[2u * nd + di];
    }
    float a = LOAD(lhs[li]);
    float b = LOAD(rhs[ri]);
    float r;
    switch (pc.op) {
        case 0u: r = a + b; break;
        case 1u: r = a - b; break;
        case 2u: r = a * b; break;
        case 3u: r = a / b; break;
        case 4u: r = max(a, b); break;
        case 5u: r = min(a, b); break;
        default: r = a;
    }
    dst[idx] = STORE(r);
}
